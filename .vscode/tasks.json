{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1) Flutter: Run (اول مرة - بناء كامل)",
      "type": "shell",
      "command": "flutter",
      "args": ["run"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "2) Flutter: Attach (بدون بناء - Hot Reload)",
      "type": "shell",
      "command": "flutter",
      "args": ["attach"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
